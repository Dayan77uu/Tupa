-- -------------------------------------------------------------------------------------
-- 7. FUNCIONES MATEMÁTICAS Y DE CONTROL DE PLAZOS
-- -------------------------------------------------------------------------------------
DELIMITER $$

CREATE FUNCTION `fn_calcular_vencimiento_habiles`(p_fecha_inicio DATETIME, p_dias_habiles INT) 
RETURNS DATE
DETERMINISTIC
BEGIN
    DECLARE v_fecha_resultado DATE;
    DECLARE v_contador INT DEFAULT 0;
    DECLARE v_es_feriado INT;
    
    SET v_fecha_resultado = DATE(p_fecha_inicio);
    
    WHILE v_contador < p_dias_habiles DO
        SET v_fecha_resultado = DATE_ADD(v_fecha_resultado, INTERVAL 1 DAY);
        
        -- Verificar si es fin de semana (Sábado = 7, Domingo = 1)
        IF DAYOFWEEK(v_fecha_resultado) NOT IN (1, 7) THEN
            SELECT COUNT(*) INTO v_es_feriado FROM `tferiado` WHERE `fecha` = v_fecha_resultado;
            IF v_es_feriado = 0 THEN
                SET v_contador = v_contador + 1;
            END IF;
        END IF;
    END WHILE;
    
    RETURN v_fecha_resultado;
END$$

DELIMITER ;

-- -------------------------------------------------------------------------------------
-- 8. TRIGGERS OBLIGATORIOS EXPLICADOS
-- -------------------------------------------------------------------------------------

-- [TRIGGER 1]: trg_expediente_inicializar_plazo
-- Objetivo: Calcular automáticamente la fecha exacta de vencimiento legal omitiendo fines de semana y feriados.
-- Evento que lo activa: BEFORE INSERT
-- Tabla afectada: texpediente
-- Regla implementada: Automatización del cálculo de la fecha límite del expediente según el plazo asignado en el catálogo.
DELIMITER $$

CREATE TRIGGER `trg_expediente_inicializar_plazo`
BEFORE INSERT ON `texpediente`
FOR EACH ROW
BEGIN
    DECLARE v_dias INT;
    SELECT `nplazodias` INTO v_dias FROM `tcatalogotramite` WHERE `ccodigo` = NEW.`ccodigo`;
    SET NEW.`fecha_vencimiento` = fn_calcular_vencimiento_habiles(NEW.`fecha_registro`, v_dias);
END$$

-- [TRIGGER 2]: trg_expediente_auditar_cambios
-- Objetivo: Generar registros automáticos del flujo de derivación de un trámite por las oficinas de la UNSAAC.
-- Evento que lo activa: AFTER UPDATE
-- Tabla afectada: texpediente
-- Regla implementada: Auditoría inalterable de los flujos de estado y trazabilidad institucional del expediente.
CREATE TRIGGER `trg_expediente_auditar_cambios`
AFTER UPDATE ON `texpediente`
FOR EACH ROW
BEGIN
    IF (OLD.`estado` <> NEW.`estado`) OR (OLD.`id_unidad_actual` <> NEW.`id_unidad_actual`) THEN
        INSERT INTO `thistorial_estado` (
            `nro_expediente`, `estado_anterior`, `estado_nuevo`, 
            `id_unidad_origen`, `id_unidad_destino`, `id_usuario_accion`, `comentario`
        ) VALUES (
            NEW.`nro_expediente`, OLD.`estado`, NEW.`estado`, 
            OLD.`id_unidad_actual`, NEW.`id_unidad_actual`, NEW.`id_solicitante`,
            'Actualización automática de estado / Derivación interna del expediente.'
        );
    END IF;
END$$

-- [TRIGGER 3]: trg_catalogo_versionamiento
-- Objetivo: Respaldar las variaciones monetarias o de plazos dictaminadas en resoluciones rectorales para el TUPA.
-- Evento que lo activa: AFTER UPDATE
-- Tabla afectada: tcatalogotramite
-- Regla implementada: Historial auditable de las modificaciones normativas del TUPA.
CREATE TRIGGER `trg_catalogo_versionamiento`
AFTER UPDATE ON `tcatalogotramite`
FOR EACH ROW
BEGIN
    IF OLD.`ncosto` <> NEW.`ncosto` THEN
        INSERT INTO `tversioncatalogo` (`ccodigo`, `id_administrador`, `campo_modificado`, `valor_anterior`, `valor_nuevo`)
        VALUES (NEW.`ccodigo`, 1, 'ncosto', CAST(OLD.`ncosto` AS CHAR), CAST(NEW.`ncosto` AS CHAR));
    END IF;
    IF OLD.`nplazodias` <> NEW.`nplazodias` THEN
        INSERT INTO `tversioncatalogo` (`ccodigo`, `id_administrador`, `campo_modificado`, `valor_anterior`, `valor_nuevo`)
        VALUES (NEW.`ccodigo`, 1, 'nplazodias', CAST(OLD.`nplazodias` AS CHAR), CAST(NEW.`nplazodias` AS CHAR));
    END IF;
END$$

DELIMITER ;

-- -------------------------------------------------------------------------------------
-- 9. VISTAS DEL SISTEMA (VIEW)
-- -------------------------------------------------------------------------------------

-- Bandeja técnica para el personal de las oficinas con semaforización de plazos urgentes
CREATE VIEW `vw_bandeja_administrativo` AS
SELECT 
    e.`nro_expediente`,
    c.`ccodigo` AS `codigo_tupa`,
    c.`cdescripcion` AS `nombre_tramite`,
    e.`fecha_registro`,
    e.`fecha_vencimiento`,
    e.`estado`,
    uo.`nombre_unidad` AS `oficina_actual`,
    DATEDIFF(e.`fecha_vencimiento`, CURDATE()) AS `dias_restantes`,
    CASE 
        WHEN DATEDIFF(e.`fecha_vencimiento`, CURDATE()) > 5 THEN 'SEGURO (VERDE)'
        WHEN DATEDIFF(e.`fecha_vencimiento`, CURDATE()) BETWEEN 1 AND 5 THEN 'URGENTE (AMARILLO)'
        ELSE 'VENCIDO (ROJO)'
    END AS `semaforo_plazo`
FROM `texpediente` e
INNER JOIN `tcatalogotramite` c ON e.`ccodigo` = c.`ccodigo`
INNER JOIN `tunidadorganizativa` uo ON e.`id_unidad_actual` = uo.`id_unidad`;

-- Catálogo Público del TUPA visible para usuarios externos sin autenticación
CREATE VIEW `vw_catalogo_publico` AS
SELECT 
    c.`ccodigo` AS `codigo_tupa`,
    c.`cdescripcion` AS `procedimiento`,
    c.`ncosto` AS `costo_soles`,
    c.`nplazodias` AS `plazo_maximo_dias`,
    uo.`nombre_unidad` AS `oficina_responsable`
FROM `tcatalogotramite` c
INNER JOIN `tunidadorganizativa` uo ON c.`id_unidad_responsable` = uo.`id_unidad`
WHERE c.`estado` = 'ACTIVO';

-- -------------------------------------------------------------------------------------
-- 10. PROCEDIMIENTOS ALMACENADOS (STORED PROCEDURES)
-- -------------------------------------------------------------------------------------
DELIMITER $$

-- Reincorporación del procedimiento base del script bdtupa20260511.sql
CREATE PROCEDURE `tupa_sp_tramites_segun_tipo_recibo`(
    IN p_nidtiporeciboingreso INT
)
BEGIN        
    SELECT DISTINCT c.* FROM `tcatalogotramite` c
    INNER JOIN `tespecificatramite` et ON c.`ccodigo` = et.`ccodigo`
    INNER JOIN `tespecifica` e ON e.`ccodigoespecifica` = et.`ccodigoespecifica`
    WHERE e.`nidtiporeciboingreso` = p_nidtiporeciboingreso    
    ORDER BY c.`cdescripcion` ASC;
END$$

-- Procedimiento transaccional seguro para el flujo crítico de subsanaciones
CREATE PROCEDURE `sp_subsanar_documento_observado`(
    IN p_id_documento INT,
    IN p_nueva_ruta VARCHAR(255)
)
BEGIN
    DECLARE v_expediente VARCHAR(25);
    
    START TRANSACTION;
    
    UPDATE `tdocumentoadjunto` 
    SET `ruta_archivo` = p_nueva_ruta, `estado_doc` = 'SUBSANADO'
    WHERE `id_documento` = p_id_documento;
    
    SELECT `nro_expediente` INTO v_expediente FROM `tdocumentoadjunto` WHERE `id_documento` = p_id_documento;
    
    UPDATE `texpediente` 
    SET `estado` = 'EN_REVISION' 
    WHERE `nro_expediente` = v_expediente;
    
    COMMIT;
END$$

DELIMITER ;

