DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bdtupa
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Mailjet: metodo principal de envio de correo (verificacion de registro y
# notificaciones de expediente). Necesario en hosts que bloquean SMTP saliente
# (Render, PythonAnywhere free, etc). Si no se configura, se usa MAIL_* (Flask-Mail)
# como respaldo.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=

# Flask-Mail: respaldo de envio de correo, solo funciona en hosts que permiten
# SMTP saliente (ej. tu maquina local). MAIL_PASSWORD es una "contrasena de
# aplicacion" de 16 caracteres (myaccount.google.com/apppasswords), no la
# contrasena normal de la cuenta.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
FRONTEND_URL=http://localhost:5173
