DROP DATABASE IF EXISTS `bdtupa`;
CREATE DATABASE `bdtupa` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
USE `bdtupa`;

-- -------------------------------------------------------------------------------------
-- 1. TABLAS DE CONFIGURACIÓN, RECAUDACIÓN Y UNIDADES ORGANIZATIVAS
-- -------------------------------------------------------------------------------------

CREATE TABLE `tferiado` (
  `id_feriado` INT AUTO_INCREMENT,
  `fecha` DATE NOT NULL,
  `descripcion` VARCHAR(150) NOT NULL,
  `recurrente` TINYINT(1) DEFAULT 0,
  PRIMARY KEY (`id_feriado`),
  UNIQUE KEY `uk_fecha_feriado` (`fecha`)
) ENGINE=InnoDB;

CREATE TABLE `tunidadorganizativa` (
  `id_unidad` INT AUTO_INCREMENT,
  `nombre_unidad` VARCHAR(150) NOT NULL,
  `sigla` VARCHAR(20) NOT NULL,
  `estado` ENUM('ACTIVO', 'INACTIVO') DEFAULT 'ACTIVO',
  PRIMARY KEY (`id_unidad`),
  UNIQUE KEY `uk_sigla_unidad` (`sigla`)
) ENGINE=InnoDB;

CREATE TABLE `ttiporeciboingreso` (
  `nidtiporeciboingreso` INT AUTO_INCREMENT,
  `cdescripcion` VARCHAR(100) NOT NULL,
  `estado` ENUM('ACTIVO', 'INACTIVO') DEFAULT 'ACTIVO',
  PRIMARY KEY (`nidtiporeciboingreso`)
) ENGINE=InnoDB;

CREATE TABLE `tespecifica` (
  `ccodigoespecifica` VARCHAR(20) NOT NULL,
  `cdescripcion` VARCHAR(255) NOT NULL,
  `nidtiporeciboingreso` INT NOT NULL,
  PRIMARY KEY (`ccodigoespecifica`),
  CONSTRAINT `fk_especifica_tipo_recibo` FOREIGN KEY (`nidtiporeciboingreso`) REFERENCES `ttiporeciboingreso` (`nidtiporeciboingreso`)
) ENGINE=InnoDB;

-- -------------------------------------------------------------------------------------
-- 2. ESTRUCTURA CENTRAL DEL CATÁLOGO TUPA
-- -------------------------------------------------------------------------------------

CREATE TABLE `tcatalogotramite` (
  `ccodigo` VARCHAR(20) NOT NULL,
  `cdescripcion` TEXT NOT NULL,
  `nplazodias` INT NOT NULL,
  `ncosto` DECIMAL(10,2) NOT NULL DEFAULT 0.00,
  `id_unidad_responsable` INT NOT NULL,
  `tipo_tramite` ENUM('PREGRADO', 'POSGRADO', 'GENERAL') NOT NULL DEFAULT 'GENERAL',
  `estado` ENUM('ACTIVO', 'INACTIVO') DEFAULT 'ACTIVO',
  `fecha_actualizacion` TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`ccodigo`),
  CONSTRAINT `fk_catalogo_unidad` FOREIGN KEY (`id_unidad_responsable`) REFERENCES `tunidadorganizativa` (`id_unidad`),
  CONSTRAINT `chk_ncosto_positivo` CHECK (`ncosto` >= 0.00),
  CONSTRAINT `chk_nplazodias_positivo` CHECK (`nplazodias` >= 0)
) ENGINE=InnoDB;

CREATE TABLE `tespecificatramite` (
  `ccodigo` VARCHAR(20) NOT NULL,
  `ccodigoespecifica` VARCHAR(20) NOT NULL,
  PRIMARY KEY (`ccodigo`, `ccodigoespecifica`),
  CONSTRAINT `fk_esptramite_catalogo` FOREIGN KEY (`ccodigo`) REFERENCES `tcatalogotramite` (`ccodigo`) ON DELETE CASCADE,
  CONSTRAINT `fk_esptramite_especifica` FOREIGN KEY (`ccodigoespecifica`) REFERENCES `tespecifica` (`ccodigoespecifica`) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE `trequisitotramite` (
  `nidrequisito` INT AUTO_INCREMENT,
  `ccodigo` VARCHAR(20) NOT NULL,
  `cdescripcion` TEXT NOT NULL,
  `es_obligatorio` TINYINT(1) DEFAULT 1,
  `formato_permitido` VARCHAR(50) DEFAULT 'PDF',
  `ntamano_max_mb` INT DEFAULT 5,
  PRIMARY KEY (`nidrequisito`),
  CONSTRAINT `fk_requisito_catalogo` FOREIGN KEY (`ccodigo`) REFERENCES `tcatalogotramite` (`ccodigo`) ON DELETE CASCADE
) ENGINE=InnoDB;

-- -------------------------------------------------------------------------------------
-- 3. CONTROL DE SEGURIDAD, ROLES (RBAC) Y USUARIOS EXTENDIDOS
-- -------------------------------------------------------------------------------------

CREATE TABLE `tusuario` (
  `id_usuario` INT AUTO_INCREMENT,
  `correo_institucional` VARCHAR(120) NOT NULL,
  `contrasena_hash` VARCHAR(255) NOT NULL,
  `rol` ENUM('USUARIO', 'ADMINISTRATIVO', 'JEFE_OFICINA', 'ADMINISTRADOR') NOT NULL DEFAULT 'USUARIO',
  `intentos_fallidos` INT DEFAULT 0,
  `estado` ENUM('ACTIVO', 'INACTIVO', 'BLOQUEADO') DEFAULT 'ACTIVO',
  `fecha_creacion` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id_usuario`),
  UNIQUE KEY `uk_correo_usuario` (`correo_institucional`),
  CONSTRAINT `chk_dominio_correo` CHECK (`correo_institucional` LIKE '%@unsaac.edu.pe')
) ENGINE=InnoDB;

CREATE TABLE `talumno` (
  `codigo_alumno` VARCHAR(15) NOT NULL,
  `id_usuario` INT NOT NULL,
  `dni` VARCHAR(8) NOT NULL,
  `nombres` VARCHAR(100) NOT NULL,
  `apellidos` VARCHAR(100) NOT NULL,
  `facultad` VARCHAR(150) NOT NULL,
  `escuela_profesional` VARCHAR(150) NOT NULL,
  PRIMARY KEY (`codigo_alumno`),
  UNIQUE KEY `uk_alumno_usuario` (`id_usuario`),
  UNIQUE KEY `uk_alumno_dni` (`dni`),
  CONSTRAINT `fk_alumno_usuario` FOREIGN KEY (`id_usuario`) REFERENCES `tusuario` (`id_usuario`) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE `tpersonal` (
  `codigo_personal` VARCHAR(15) NOT NULL,
  `id_usuario` INT NOT NULL,
  `dni` VARCHAR(8) NOT NULL,
  `nombres` VARCHAR(100) NOT NULL,
  `apellidos` VARCHAR(100) NOT NULL,
  `id_unidad` INT NOT NULL,
  PRIMARY KEY (`codigo_personal`),
  UNIQUE KEY `uk_personal_usuario` (`id_usuario`),
  UNIQUE KEY `uk_personal_dni` (`dni`),
  CONSTRAINT `fk_personal_usuario` FOREIGN KEY (`id_usuario`) REFERENCES `tusuario` (`id_usuario`) ON DELETE CASCADE,
  CONSTRAINT `fk_personal_unidad` FOREIGN KEY (`id_unidad`) REFERENCES `tunidadorganizativa` (`id_unidad`)
) ENGINE=InnoDB;

-- -------------------------------------------------------------------------------------
-- 4. TRANSACCIONES: EXPEDIENTES, REQUISITOS ADJUNTOS Y HISTORIALES
-- -------------------------------------------------------------------------------------

CREATE TABLE `texpediente` (
  `nro_expediente` VARCHAR(25) NOT NULL,
  `ccodigo` VARCHAR(20) NOT NULL,
  `id_solicitante` INT NOT NULL,
  `id_unidad_actual` INT NOT NULL,
  `fecha_registro` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `fecha_vencimiento` DATE NOT NULL,
  `estado` ENUM('PENDIENTE', 'EN_REVISION', 'OBSERVADO', 'APROBADO', 'RECHAZADO') DEFAULT 'PENDIENTE',
  PRIMARY KEY (`nro_expediente`),
  CONSTRAINT `fk_expediente_catalogo` FOREIGN KEY (`ccodigo`) REFERENCES `tcatalogotramite` (`ccodigo`),
  CONSTRAINT `fk_expediente_solicitante` FOREIGN KEY (`id_solicitante`) REFERENCES `tusuario` (`id_usuario`),
  CONSTRAINT `fk_expediente_unidad` FOREIGN KEY (`id_unidad_actual`) REFERENCES `tunidadorganizativa` (`id_unidad`)
) ENGINE=InnoDB;

CREATE TABLE `tdocumentoadjunto` (
  `id_documento` INT AUTO_INCREMENT,
  `nro_expediente` VARCHAR(25) NOT NULL,
  `nidrequisito` INT NOT NULL,
  `ruta_archivo` VARCHAR(255) NOT NULL,
  `fecha_subida` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  `estado_doc` ENUM('VALIDO', 'OBSERVADO', 'SUBSANADO') DEFAULT 'VALIDO',
  `observacion_admin` TEXT,
  PRIMARY KEY (`id_documento`),
  CONSTRAINT `fk_doc_expediente` FOREIGN KEY (`nro_expediente`) REFERENCES `texpediente` (`nro_expediente`) ON DELETE CASCADE,
  CONSTRAINT `fk_doc_requisito` FOREIGN KEY (`nidrequisito`) REFERENCES `trequisitotramite` (`nidrequisito`)
) ENGINE=InnoDB;

CREATE TABLE `tvoucher_pago` (
  `id_pago` INT AUTO_INCREMENT,
  `nro_expediente` VARCHAR(25) NOT NULL,
  `codigo_operacion` VARCHAR(60) NOT NULL,
  `monto_pagado` DECIMAL(10,2) NOT NULL,
  `fecha_pago` DATE NOT NULL,
  `ruta_voucher` VARCHAR(255) NOT NULL,
  `estado_validacion` ENUM('PENDIENTE', 'VALIDADO', 'RECHAZADO') DEFAULT 'PENDIENTE',
  `id_admin_validador` INT DEFAULT NULL,
  PRIMARY KEY (`id_pago`),
  UNIQUE KEY `uk_codigo_operacion` (`codigo_operacion`),
  CONSTRAINT `fk_pago_expediente` FOREIGN KEY (`nro_expediente`) REFERENCES `texpediente` (`nro_expediente`) ON DELETE CASCADE,
  CONSTRAINT `fk_pago_validador` FOREIGN KEY (`id_admin_validador`) REFERENCES `tusuario` (`id_usuario`)
) ENGINE=InnoDB;

-- -------------------------------------------------------------------------------------
-- 5. TABLAS DE HISTÓRICOS Y AUDITORÍA COMPLETA
-- -------------------------------------------------------------------------------------

CREATE TABLE `thistorial_estado` (
  `id_historial` INT AUTO_INCREMENT,
  `nro_expediente` VARCHAR(25) NOT NULL,
  `fecha_movimiento` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  `estado_anterior` VARCHAR(30) DEFAULT NULL,
  `estado_nuevo` VARCHAR(30) NOT NULL,
  `id_unidad_origen` INT DEFAULT NULL,
  `id_unidad_destino` INT NOT NULL,
  `id_usuario_accion` INT NOT NULL,
  `comentario` TEXT,
  PRIMARY KEY (`id_historial`),
  CONSTRAINT `fk_historial_exp` FOREIGN KEY (`nro_expediente`) REFERENCES `texpediente` (`nro_expediente`) ON DELETE CASCADE,
  CONSTRAINT `fk_historial_uorigen` FOREIGN KEY (`id_unidad_origen`) REFERENCES `tunidadorganizativa` (`id_unidad`),
  CONSTRAINT `fk_historial_udestino` FOREIGN KEY (`id_unidad_destino`) REFERENCES `tunidadorganizativa` (`id_unidad`),
  CONSTRAINT `fk_historial_usuario` FOREIGN KEY (`id_usuario_accion`) REFERENCES `tusuario` (`id_usuario`)
) ENGINE=InnoDB;

CREATE TABLE `tversioncatalogo` (
  `id_version` INT AUTO_INCREMENT,
  `ccodigo` VARCHAR(20) NOT NULL,
  `fecha_modificacion` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  `id_administrador` INT NOT NULL,
  `campo_modificado` VARCHAR(100) NOT NULL,
  `valor_anterior` TEXT,
  `valor_nuevo` TEXT,
  PRIMARY KEY (`id_version`),
  CONSTRAINT `fk_version_usuario` FOREIGN KEY (`id_administrador`) REFERENCES `tusuario` (`id_usuario`)
) ENGINE=InnoDB;

